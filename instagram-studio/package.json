{
  "name": "aptorrescusa-instagram-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de carruseles animados y publicación programada para el Instagram de A.P. Torrescusa (@aptorrescusa)",
  "type": "module",
